# Copy to .env (gitignored) and fill in. Read by docker compose (--env-file .env)
# and by the worker. Never add ANTHROPIC_API_KEY here: the agent runs on the
# local Claude login, and the worker refuses to start if that variable is set.

# --- GitHub: the fork the agent works on ---
GITHUB_FORK=
# scripts/prepare_demo_repo.py names the repository's default branch after this value.
GITHUB_BASE_BRANCH=main
# Fine-grained PAT: Contents, Issues and Pull requests, each read and write. The demo
# setup script also needs Administration (read and write) and, to create the repository,
# access to all repositories; its token recipe is at the top of scripts/prepare_demo_repo.py.
GITHUB_PAT=

# --- Langfuse Cloud (EU): agent console ---
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Keycloak (local lab IdP) ---
KEYCLOAK_ADMIN_PASSWORD=
KC_AGENT_WORKER_SECRET=

# --- Agent ---
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=80

# --- Target repo commands, run inside the sandbox container ---
# Example values for a fork of mahmoud/boltons, the baseline training target.
TARGET_INSTALL_COMMAND=pip install -e . "pytest>=8"
TARGET_TEST_COMMAND=python -m pytest -q --doctest-modules boltons tests
